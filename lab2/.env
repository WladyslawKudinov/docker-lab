# ============================================================================
#  .env: переменные окружения для docker-compose.yml
# ============================================================================
#
#  ЧТО ЭТО ЗА ФАЙЛ
#
#  Простой текстовый файл, в каждой строке пара ИМЯ=ЗНАЧЕНИЕ. Строки с #
#  это комментарии. Пробелов вокруг = быть не должно, кавычки не нужны.
#
#  docker compose использует этот файл двумя способами:
#
#  1. Подстановка в сам docker-compose.yml. Файл с именем .env, лежащий
#     рядом с docker-compose.yml, compose читает автоматически. Везде, где
#     в docker-compose.yml написано ${ИМЯ}, compose до запуска подставит
#     значение отсюда. Например, `image: ${APP_IMAGE}` превратится в
#     `image: lab2-app:1.0`.
#
#  2. Передача внутрь контейнеров. У каждого сервиса в docker-compose.yml
#     написано `env_file: .env`. Это значит "все переменные из этого файла
#     сделать переменными окружения процесса в контейнере". Так приложение
#     узнаёт DATA_DIR, init узнаёт COUNTER_START, а nginx узнаёт APP_HOST
#     и APP_PORT.
#
#  ЗАЧЕМ ВЫНОСИТЬ НАСТРОЙКИ СЮДА, А НЕ ПИСАТЬ ПРЯМО В docker-compose.yml
#
#  - docker-compose.yml описывает, ИЗ ЧЕГО состоит система, и почти не
#    меняется. .env описывает, С КАКИМИ НАСТРОЙКАМИ её запускать, и у
#    каждого разработчика или сервера может быть свой. Чтобы поменять порт
#    или версию, не нужно лезть в описание сервисов.
#  - Одна настройка в одном месте. APP_PORT используется и приложением, и
#    nginx, и проверкой здоровья. Поменял здесь, поменялось везде.
#  - Пароли и ключи. В реальных проектах здесь лежат секреты, и файл .env
#    НЕ кладут в git (добавляют в .gitignore), а в репозиторий кладут
#    пример .env.example без настоящих значений. В этом проекте паролей
#    нет, поэтому файл лежит в репозитории целиком.
#
#  Проверить, что получилось после подстановки:
#      docker compose config
#  (выведет docker-compose.yml, где все ${...} уже заменены значениями).
# ============================================================================


# Имя проекта. compose добавляет его к именам всего, что создаёт, если имя
# не задано явно. Без этой строки имя бралось бы из названия папки, и у
# людей с разными названиями папок получались бы разные имена.
COMPOSE_PROJECT_NAME=lab2

# Имя и тег (версия после двоеточия), которые compose присвоит собранному
# образу приложения. Посмотреть: docker images lab2-app
APP_IMAGE=lab2-app:1.0

# Готовый образ nginx с Docker Hub. Версия указана точно, а не latest,
# чтобы сборка через год дала то же самое. alpine значит "на основе
# маленького дистрибутива Alpine Linux", образ весит около 50 МБ.
NGINX_IMAGE=nginx:1.27-alpine

# Папка внутри контейнера, где приложение хранит файл счётчика.
# Приложение читает эту переменную (см. app/app.py).
DATA_DIR=/data

# С какого числа начинать счёт. Сервис init записывает это число в файл
# счётчика, если файла ещё нет. Первый запрос вернёт COUNTER_START + 1.
COUNTER_START=100

# Как nginx находит приложение во внутренней сети Docker: имя контейнера
# приложения и порт, который слушает gunicorn внутри него.
APP_HOST=lab2-app
APP_PORT=5000

# Порт на твоём компьютере, по которому открывается сервис:
# http://localhost:8080/
PROXY_PORT=8080
