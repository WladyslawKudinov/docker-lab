# ============================================================================
#  Настройка nginx для сервиса proxy из docker-compose.yml
# ============================================================================
#
#  ЧТО ТАКОЕ NGINX И ЗАЧЕМ ОН ЗДЕСЬ
#
#  nginx это веб-сервер. Здесь он работает как "обратный прокси" (reverse
#  proxy): принимает запросы от браузера и пересылает их нашему
#  приложению, а ответ приложения отдаёт обратно. Браузер общается только
#  с nginx и не знает, что за ним стоит.
#
#      браузер --> localhost:8080 --> контейнер lab2-proxy (nginx, порт 80)
#                                           |
#                                           v   внутренняя сеть lab2-net
#                                     контейнер lab2-app (gunicorn, порт 5000)
#
#  Зачем так, если можно открыть порт приложения напрямую: так делают в
#  реальных проектах. Наружу смотрит только nginx, а приложение спрятано во
#  внутренней сети Docker и снаружи недоступно. nginx обычно берёт на себя
#  HTTPS, сжатие, отдачу статических файлов, распределение запросов между
#  несколькими копиями приложения.
#
#  ПОЧЕМУ ФАЙЛ НАЗЫВАЕТСЯ .template
#
#  Внутри есть записи вида ${APP_HOST}. Это не синтаксис nginx, nginx их
#  не понимает. Официальный образ nginx при старте контейнера делает
#  следующее: берёт каждый файл из /etc/nginx/templates/ с окончанием
#  .template, подставляет вместо ${ИМЯ} значения переменных окружения
#  контейнера и сохраняет результат без .template в /etc/nginx/conf.d/.
#  Получается обычный файл настроек /etc/nginx/conf.d/default.conf.
#
#  Переменные APP_HOST и APP_PORT попадают в контейнер из файла .env
#  (строка `env_file: .env` в docker-compose.yml). Так адрес приложения
#  задан в одном месте, а не продублирован здесь и в compose.
#
#  Посмотреть, что получилось после подстановки:
#      docker exec lab2-proxy cat /etc/nginx/conf.d/default.conf
# ============================================================================

# server { ... } описывает один сайт, который обслуживает nginx.
server {
    # Слушать порт 80 внутри контейнера. Наружу он пробрасывается как
    # порт 8080 (раздел ports у сервиса proxy в docker-compose.yml).
    listen 80;

    # location / значит "все адреса, начиная с /", то есть вообще все.
    location / {
        # Переслать запрос по адресу http://lab2-app:5000.
        # Почему по имени, а не по IP-адресу: внутри сети Docker у каждого
        # контейнера есть имя, и Docker сам превращает его в IP-адрес
        # (у Docker есть встроенный DNS). IP-адрес контейнера меняется при
        # каждом пересоздании, имя остаётся.
        proxy_pass http://${APP_HOST}:${APP_PORT};

        # Передать приложению, какой адрес изначально запросил браузер и
        # с какого IP пришёл запрос. Без этих строк приложение видело бы
        # вместо клиента сам nginx.
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}
