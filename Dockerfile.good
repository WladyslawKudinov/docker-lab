# ============================================================================
#  ХОРОШИЙ Dockerfile
#  Собирает то же приложение, но правильно. Над каждой командой написано,
#  что она делает, почему сделано именно так и что было бы при плохом
#  варианте. Файл читается сам по себе, в другие заглядывать не нужно.
#
#  Собрать:    docker build -f Dockerfile.good -t lab1-good .
#  Запустить:  docker run -d -p 5001:5000 -v lab1-data:/data --name good lab1-good
#  Проверить:  curl localhost:5001/        (ответ: Visits: 1)
# ============================================================================
#
#  СЛОВАРЬ (минимум, без которого дальше непонятно)
#
#  Образ (image)      Архив с файловой системой: ОС, Python, библиотеки, наш
#                     код. Сам по себе ничего не делает, это "шаблон".
#  Контейнер          Запущенный из образа процесс. Из одного образа можно
#                     запустить сколько угодно контейнеров.
#  Dockerfile         Этот файл: рецепт, по которому `docker build` собирает
#                     образ. Выполняется сверху вниз, команда за командой.
#  Слой (layer)       Результат одной команды FROM / RUN / COPY. Образ это
#                     стопка слоёв. Удалить файл из нижнего слоя нельзя:
#                     он уже занял место.
#  Кэш сборки         Docker запоминает слои. Если команда и всё, что выше
#                     неё, не изменилось, слой берётся готовым. Как только
#                     один слой изменился, ВСЕ слои ниже пересобираются.
#                     Отсюда главное правило порядка: то, что меняется
#                     редко, пишем выше; то, что часто, ниже.
#  Volume (том)       Папка, которая хранится ВНЕ контейнера и подключается
#                     к нему. Контейнер можно удалить, данные останутся.
# ============================================================================


# ---------------------------------------------------------------------------
# FROM: на чём строим. Берём готовый образ с Python с Docker Hub.
#
# Почему именно `python:3.12-slim`:
#   - `3.12` это конкретная версия. Сборка сегодня и через год даст один
#     и тот же Python. Если написать `python:latest` ("самая свежая"),
#     версия однажды сменится сама, и приложение может сломаться без
#     единой правки с твоей стороны.
#   - `slim` это урезанный вариант: только то, что нужно для запуска
#     Python. Полный образ весит больше гигабайта из-за компиляторов и
#     утилит, которые нам не нужны. Наш итоговый образ 190 МБ.
#     Меньше программ внутри означает меньше уязвимостей и быстрее загрузку.
# ---------------------------------------------------------------------------
FROM python:3.12-slim


# ---------------------------------------------------------------------------
# ENV: переменные окружения, которые будут у процесса внутри контейнера.
# Обратный слэш в конце строки значит "команда продолжается на следующей".
#
#   PYTHONDONTWRITEBYTECODE=1  Python не создаёт служебные файлы .pyc.
#                              В контейнере они только занимают место.
#   PYTHONUNBUFFERED=1         Python сразу печатает вывод, не накапливая
#                              его. Без этого `docker logs` показывает логи
#                              с задержкой или теряет последние строки.
#   DATA_DIR=/data             Папка, куда приложение кладёт файл счётчика
#                              (app.py читает эту переменную).
#
# Здесь лежат только настройки. Пароли и ключи в ENV писать НЕЛЬЗЯ: всё из
# Dockerfile навсегда остаётся в образе и читается командой
# `docker history`. Секреты передают при запуске:
#     docker run -e SECRET_KEY=... lab1-good
# ---------------------------------------------------------------------------
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    DATA_DIR=/data


# ---------------------------------------------------------------------------
# WORKDIR: текущая папка для всех следующих команд (как `cd`, но папка ещё
# и создаётся, если её нет). Дальше точка `.` в COPY означает /app.
# ---------------------------------------------------------------------------
WORKDIR /app


# ---------------------------------------------------------------------------
# Установка библиотек. Порядок этих строк и есть главная хитрость файла.
#
# COPY копирует файл с твоего компьютера в образ. Сначала копируем ТОЛЬКО
# requirements.txt (список библиотек) и ставим их. Код копируем позже.
#
# Зачем так: вспомни про кэш. Docker пересобирает слой, если изменились
# скопированные файлы, и вместе с ним все слои ниже. Код меняется каждый
# день, список библиотек раз в месяц. При таком порядке правка в app.py
# не трогает слой с `pip install`: он берётся из кэша, сборка занимает
# секунду. Если бы мы сначала скопировали весь код, а потом ставили
# библиотеки, они скачивались бы заново после каждой правки.
#
# pip это установщик библиотек Python.
#   -r requirements.txt   ставить всё по списку из файла. В файле версии
#                         указаны точно (flask==3.0.3), поэтому набор
#                         библиотек всегда одинаковый.
#   --no-cache-dir        не сохранять скачанные архивы. Обычно pip хранит
#                         их, чтобы не качать повторно, но в образе
#                         повторной установки не будет, это лишний вес.
#
# Системные пакеты через apt-get мы не ставим вообще: приложению они не
# нужны. Если бы понадобились, правильная запись такая (одна команда,
# только нужное, мусор удалён в том же слое):
#     RUN apt-get update \
#         && apt-get install -y --no-install-recommends ИМЯ_ПАКЕТА \
#         && rm -rf /var/lib/apt/lists/*
# ---------------------------------------------------------------------------
COPY app/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt


# ---------------------------------------------------------------------------
# Теперь код. Он меняется чаще всего, поэтому стоит ниже библиотек.
# Копируем один конкретный файл, а не всю папку: в образ попадает только
# то, что нужно для работы.
# ---------------------------------------------------------------------------
COPY app/app.py .


# ---------------------------------------------------------------------------
# Обычный пользователь вместо root.
#
# В Linux root это администратор, которому можно всё. Если не написать
# USER, приложение в контейнере работает от root. Тогда любой, кто
# взломает приложение, сразу получает права администратора внутри
# контейнера и намного больше шансов добраться до основной системы.
# Веб-сервису такие права не нужны, поэтому создаём ему отдельного
# пользователя без привилегий.
#
#   useradd --system      создать служебного пользователя (без пароля и
#                         возможности войти в систему)
#   --uid 1001            задать ему фиксированный номер. Linux различает
#                         пользователей по номерам, и постоянный номер
#                         упрощает настройку прав на подключаемые папки.
#   mkdir /data           создать папку для данных
#   chown appuser /data   сделать пользователя её владельцем, иначе он не
#                         сможет записать туда счётчик
#
# `&&` значит "выполни следующее, только если предыдущее удалось".
# Три действия собраны в один RUN, чтобы получился один слой, а не три.
#
# USER переключает пользователя. Всё, что ниже, и само приложение
# работают уже от appuser. Поэтому USER стоит ПОСЛЕ команд, которым
# нужны права администратора (useradd, chown).
#
# Проверка:  docker exec good id -u      (выведет 1001; у root было бы 0)
# ---------------------------------------------------------------------------
RUN useradd --system --uid 1001 appuser \
    && mkdir /data && chown appuser /data
USER appuser


# ---------------------------------------------------------------------------
# VOLUME: объявляем, что в /data лежат данные, которые надо хранить
# отдельно от контейнера.
#
# Зачем: всё, что контейнер записал внутрь себя, пропадает, когда его
# удаляют. А удаляют контейнеры постоянно: при каждом обновлении версии
# старый удаляется и запускается новый. Том (volume) живёт отдельно.
#
# При запуске том подключается флагом -v:
#     docker run -v lab1-data:/data ...
#   "том с именем lab1-data подключить в папку /data внутри контейнера".
#   Docker создаст том сам, если его ещё нет.
#
# Проверка:
#     curl localhost:5001/     -> Visits: 1
#     curl localhost:5001/     -> Visits: 2
#     docker rm -f good        удаляем контейнер
#     docker run -d -p 5001:5000 -v lab1-data:/data --name good lab1-good
#     curl localhost:5001/     -> Visits: 3   счётчик не сбросился
#   Список томов: docker volume ls
# ---------------------------------------------------------------------------
VOLUME /data


# ---------------------------------------------------------------------------
# EXPOSE: пометка "приложение слушает порт 5000". Сама порт НЕ открывает,
# это подсказка для людей и инструментов. Открывает порт флаг -p:
#     docker run -p 5001:5000 ...
#   "порт 5001 моего компьютера соединить с портом 5000 контейнера".
# ---------------------------------------------------------------------------
EXPOSE 5000


# ---------------------------------------------------------------------------
# HEALTHCHECK: как Docker проверяет, что приложение живо.
#
# Без неё Docker знает только "процесс запущен". Приложение может
# зависнуть и перестать отвечать, а контейнер будет числиться рабочим.
# Здесь Docker каждые 30 секунд выполняет команду после CMD. Она
# запрашивает адрес /health нашего сервиса. Если ответа нет дольше
# 3 секунд или пришла ошибка, проверка провалена; после трёх провалов
# подряд контейнер помечается unhealthy. По этому статусу системы вроде
# Kubernetes перезапускают контейнер.
#
# Почему проверка написана на python, а не через curl: в slim-образе
# curl нет, а ставить программу ради одной проверки значит раздувать образ.
#
# Проверка:  docker ps     (в колонке STATUS будет "healthy")
# ---------------------------------------------------------------------------
HEALTHCHECK --interval=30s --timeout=3s \
    CMD python -c "import urllib.request as u; u.urlopen('http://localhost:5000/health')"


# ---------------------------------------------------------------------------
# CMD: что запускается при старте контейнера.
#
# 1) Почему квадратные скобки. Команду можно записать двумя способами:
#        CMD gunicorn app:app             shell-форма
#        CMD ["gunicorn", "app:app"]      exec-форма (как здесь)
#    В shell-форме Docker запускает командную оболочку /bin/sh, а она уже
#    запускает программу. Главным процессом контейнера (PID 1) становится
#    оболочка. При `docker stop` Docker просит главный процесс завершиться
#    (сигнал SIGTERM), оболочка эту просьбу приложению не передаёт, Docker
#    ждёт 10 секунд и убивает контейнер принудительно (SIGKILL).
#    Приложение не успевает корректно закончить работу.
#    В exec-форме наша программа сама становится PID 1 и получает сигнал.
#
# 2) Почему gunicorn, а не `python app.py`. `python app.py` запускает
#    встроенный сервер Flask, он предназначен только для отладки (сам пишет
#    об этом при старте) и на сигнал завершения не реагирует. gunicorn это
#    настоящий сервер для Python-приложений: получив SIGTERM, он
#    дообрабатывает текущие запросы и выходит.
#        --bind 0.0.0.0:5000   слушать порт 5000 на всех сетевых адресах.
#                              С 127.0.0.1 сервис был бы доступен только
#                              изнутри контейнера, и -p не помог бы.
#        --workers 1           один рабочий процесс. Счётчик хранится в
#                              файле, два процесса могли бы писать в него
#                              одновременно и терять значения.
#        --access-logfile -    писать лог запросов в вывод контейнера,
#                              чтобы его показывал `docker logs`.
#        app:app               "в файле app.py взять объект app".
#
# 3) Почему CMD, а не ENTRYPOINT. CMD легко подменить при запуске, это
#    удобно для отладки:  docker run -it lab1-good sh   (откроет консоль
#    внутри контейнера вместо запуска сервера).
#
# Проверка:
#     time docker stop good                                (меньше секунды)
#     docker inspect good --format '{{.State.ExitCode}}'   (0 = вышел сам)
# ---------------------------------------------------------------------------
CMD ["gunicorn", "--bind", "0.0.0.0:5000", "--workers", "1", "--access-logfile", "-", "app:app"]
