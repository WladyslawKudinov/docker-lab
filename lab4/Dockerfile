# ============================================================================
#  Dockerfile: рецепт собственного образа lab4-app:1.0 для веб-сервиса со
#  счётчиком посещений. Из этого образа Kubernetes запускает два
#  контейнера в поде приложения: init-контейнер и основной контейнер
#  (см. k8s/40-app-deployment.yaml).
#
#  Образ собирается прямо внутри Minikube, чтобы кластер видел его без
#  публикации на Docker Hub. Команда (из папки lab4/):
#      minikube image build -t lab4-app:1.0 .
#  Проверить, что образ появился в кластере:
#      minikube image ls | grep lab4-app
# ============================================================================
#
#  СЛОВАРЬ
#
#  Образ (image)      Архив с файловой системой: ОС, Python, библиотеки, наш
#                     код. Сам по себе ничего не делает, это "шаблон".
#  Контейнер          Запущенный из образа процесс.
#  Под (pod)          Минимальная единица в Kubernetes: один или несколько
#                     контейнеров, которые запускаются вместе на одной
#                     машине и могут пользоваться общими томами.
#  Слой (layer)       Результат одной команды FROM / RUN / COPY. Образ это
#                     стопка слоёв.
#  Кэш сборки         Если команда и всё, что выше неё, не изменилось, слой
#                     берётся готовым. Как только один слой изменился, ВСЕ
#                     слои ниже пересобираются. Поэтому то, что меняется
#                     редко, пишем выше, а то, что часто, ниже.
# ============================================================================


# ---------------------------------------------------------------------------
# FROM: на чём строим. Готовый образ с Python с Docker Hub.
#   `3.12`  конкретная версия: сборка сегодня и через год даст один и тот
#           же Python. С `latest` версия однажды сменится сама.
#   `slim`  урезанный вариант, только то, что нужно для запуска Python.
#           Меньше программ внутри: меньше уязвимостей, быстрее загрузка.
# ---------------------------------------------------------------------------
FROM python:3.12-slim


# ---------------------------------------------------------------------------
# ENV: переменные окружения процесса внутри контейнера.
#   PYTHONDONTWRITEBYTECODE=1  не создавать служебные файлы .pyc
#   PYTHONUNBUFFERED=1         печатать вывод сразу. Без этого
#                              `kubectl logs` показывает логи с задержкой.
#
# Настройки приложения (DATA_DIR, COUNTER_START) и токен (RESET_TOKEN) здесь
# НЕ задаются. Их передаёт Kubernetes из ConfigMap и Secret при запуске
# контейнера. Так один и тот же образ можно запускать с разными
# настройками, не пересобирая его. А пароли в Dockerfile писать нельзя
# совсем: всё отсюда навсегда остаётся в образе и видно через
# `docker history`.
# ---------------------------------------------------------------------------
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1


# ---------------------------------------------------------------------------
# WORKDIR: текущая папка для всех следующих команд (как `cd`, папка
# создаётся, если её нет).
# ---------------------------------------------------------------------------
WORKDIR /app


# ---------------------------------------------------------------------------
# Сначала копируем ТОЛЬКО список библиотек и ставим их, код копируем позже.
# Код меняется часто, список библиотек редко. При таком порядке правка в
# app.py не трогает слой с `pip install`, он берётся из кэша.
#   --no-cache-dir   не хранить скачанные архивы pip внутри образа
# ---------------------------------------------------------------------------
COPY app/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt


# ---------------------------------------------------------------------------
# Код приложения. Копируем один нужный файл, а не всю папку.
# ---------------------------------------------------------------------------
COPY app/app.py .


# ---------------------------------------------------------------------------
# Обычный пользователь вместо root.
#
# Если не написать USER, приложение работает от root (администратора).
# Взломав приложение, злоумышленник сразу получил бы права администратора
# в контейнере. Веб-сервису они не нужны.
#
#   useradd --system --uid 1001 appuser   служебный пользователь с
#                                         фиксированным номером 1001
#   mkdir /data && chown appuser /data    папка для данных, владелец appuser
#
# Почему `USER 1001`, а не `USER appuser`. В манифесте Kubernetes стоит
# проверка runAsNonRoot: true ("не запускать контейнер от root"). Kubernetes
# не заглядывает внутрь образа и не знает, кто такой appuser. Он умеет
# проверить только номер: 1001 не 0, значит не root. С именем вместо номера
# под не запустился бы с ошибкой "image has non-numeric user".
# ---------------------------------------------------------------------------
RUN useradd --system --uid 1001 appuser \
    && mkdir /data && chown appuser /data
USER 1001


# ---------------------------------------------------------------------------
# EXPOSE: пометка "приложение слушает порт 5000". Порт она не открывает.
# В Kubernetes доступ к поду открывает Service (k8s/50-app-service.yaml).
# ---------------------------------------------------------------------------
EXPOSE 5000


# ---------------------------------------------------------------------------
# Чего здесь нет по сравнению с Dockerfile для docker compose
#
#   HEALTHCHECK  Kubernetes его игнорирует. Вместо него в манифесте
#                Deployment заданы livenessProbe и readinessProbe.
#   VOLUME       тоже не нужен: какой том подключить в /data, Kubernetes
#                решает по разделу volumes в манифесте. Папка /data
#                создана выше, чтобы приложение работало и без тома.
# ---------------------------------------------------------------------------


# ---------------------------------------------------------------------------
# CMD: что запускается при старте контейнера.
#
# Квадратные скобки (exec-форма): gunicorn сам становится главным процессом
# (PID 1) и получает сигнал SIGTERM, когда Kubernetes останавливает под.
# В форме без скобок главным процессом была бы оболочка /bin/sh, она не
# передаёт сигнал дальше, и Kubernetes через 30 секунд убил бы контейнер
# принудительно.
#
# gunicorn это настоящий сервер для Python-приложений (встроенный сервер
# Flask только для отладки).
#   --bind 0.0.0.0:5000   слушать порт 5000 на всех адресах
#   --workers 1           один процесс: два процесса могли бы писать в файл
#                         счётчика одновременно и терять значения
#   --access-logfile -    лог запросов в вывод контейнера, для `kubectl logs`
#   app:app               в файле app.py взять объект app
#
# CMD, а не ENTRYPOINT, потому что CMD легко заменить. Init-контейнер
# запускается из этого же образа, но в манифесте ему задана другая команда
# (поле command), и вместо сервера он выполняет короткий скрипт.
# ---------------------------------------------------------------------------
CMD ["gunicorn", "--bind", "0.0.0.0:5000", "--workers", "1", "--access-logfile", "-", "app:app"]
